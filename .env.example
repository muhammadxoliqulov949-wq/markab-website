# Markab 2.0 — data source configuration
#
# The production API (https://api.markab.uz/api/v1/) requires a Bearer token.
# No credentials are bundled with this repository and none are required to run
# the prototype.
#
# 'mock'  → local fixture provider built from verified public listing data
#           (DEFAULT; safe for local development, previews, tests)
# 'http'  → real Markab API (requires MARKAB_API_TOKEN; see docs/REAL-API-INTEGRATION.md)

MARKAB_DATA_SOURCE=mock
MARKAB_API_BASE_URL=https://api.markab.uz/api/v1
MARKAB_API_TOKEN=

# ---------------------------------------------------------------------------
# HTTP client policy (only meaningful when MARKAB_DATA_SOURCE=http)
# ---------------------------------------------------------------------------

# Per-request timeout in milliseconds. Default 8000. Must be finite and ≥500.
# MARKAB_API_TIMEOUT_MS=8000

# Maximum number of retries on transient failure (network errors, timeouts,
# 5xx, 429 with Retry-After). Default 1. Range 0–3. Retries are bounded with
# exponential backoff capped at 2 seconds and never fire for 401/403/404 or
# malformed responses.
# MARKAB_API_MAX_RETRIES=1

# Sitemap rendering policy.
# Default is TRUE when MARKAB_DATA_SOURCE=http (catalogue sitemap rendered per
# request so it reflects live inventory rather than a build-time snapshot) and
# FALSE when MARKAB_DATA_SOURCE=mock. Override only when serving a sitemap
# generated out-of-band.
# MARKAB_DYNAMIC_SITEMAP=true

# ---------------------------------------------------------------------------
# Security-relevant deployment properties
#
# These are switches, not secrets, and every one of them defaults to the
# production-correct value. Setting one is a statement about the deployment,
# so each is named for what it does rather than for how it feels.
# ---------------------------------------------------------------------------

# next/image optimisation. Default (unset): ON — responsive srcset, WebP and
# width-constrained variants. Set to 'true' ONLY for a deployment whose server
# cannot complete an outbound TLS fetch to api.markab.uz; the browser then
# fetches the original directly. Production must leave this unset.
# MARKAB_IMAGE_UNOPTIMIZED=true

# Allow the app to be rendered inside the Arena preview iframe. Default
# (unset): the site refuses to be framed at all (frame-ancestors 'none' +
# X-Frame-Options: DENY) and sends a two-year HSTS policy. Setting this relaxes
# framing to the preview origins and shortens HSTS, because a long-lived
# includeSubDomains entry on a shared preview domain would be recorded against
# infrastructure that is not ours. Production must leave this unset.
# MARKAB_ALLOW_PREVIEW_FRAME=true

# Where the browser should send Content-Security-Policy violations.
# Unset by default, and that is deliberate: a report endpoint is a choice about
# who receives data about your visitors, so it must not default to anyone. Set
# it to the hardened in-app receiver at /api/csp-report, or to an external
# collector — the header is not tied to that route.
# MARKAB_CSP_REPORT_ENDPOINT=/api/csp-report

# ---------------------------------------------------------------------------
# Rules
#
#   • Never add a NEXT_PUBLIC_* variable that holds a secret: every
#     NEXT_PUBLIC_* value is inlined into the JavaScript sent to browsers.
#   • Secrets belong in the platform's secret store and are read through
#     lib/env/server.ts, which is server-only by construction.
#   • When MARKAB_DATA_SOURCE=http and MARKAB_API_TOKEN is empty, httpProvider
#     returns `unavailable` for every endpoint — it NEVER fires unauthenticated
#     requests and NEVER falls back to fixture data.
#   • This file is committed. .env, .env.local and .env*.local are not
#     (see .gitignore) — keep real values out of every one of them anyway.
# ---------------------------------------------------------------------------
