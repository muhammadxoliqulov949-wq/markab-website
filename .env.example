# Markab 2.0 — data source configuration (prototype)
#
# The production API (https://api.markab.uz/api/v1/) requires a Bearer token.
# No credentials are bundled with this repository and none are required to run
# the prototype.
#
# 'mock'  → local fixture provider built from verified public listing data
# 'http'  → real Markab API (requires MARKAB_API_TOKEN; not implemented yet)

MARKAB_DATA_SOURCE=mock
MARKAB_API_BASE_URL=https://api.markab.uz/api/v1
MARKAB_API_TOKEN=
